# Copy to a private runtime environment and chmod 600. Never commit real values.
# Rust accepts these preferred names and the legacy aliases below.
COOLIFY_BASE_URL=https://your-coolify.example
COOLIFY_ACCESS_TOKEN=replace-with-complete-coolify-token
# COOLIFY_URL=https://your-coolify.example
# COOLIFY_TOKEN=replace-with-complete-coolify-token

MCP_TRANSPORT=stdio
# MCP_TRANSPORT=http
# Concrete hosted host under *.social.dpdns.org:
# MCP_PUBLIC_URL=https://mcp.social.dpdns.org
# MCP_DATABASE_PATH=/data/tenant.sqlite
# MCP_CONNECTION_ENCRYPTION_KEY=replace-with-random-key-material
# GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
# GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
# GITHUB_CALLBACK_URL=https://mcp.social.dpdns.org/auth/github/callback
# MCP_PORT=8080
# MCP_CAPABILITY_PROFILE=read-only
# MCP_OAUTH_STATE_FILE=/data/oauth-state.json
# OAuth signing key is stored beside this file as oauth-state.key (mode 600); mount both across restarts.
# MCP_AUDIT_LOG=/data/audit.jsonl
# MCP_ACCESS_TOKEN_TTL=3600
# MCP_REFRESH_TOKEN_TTL=2592000
