# Copy to /etc/coolify-mcp/multitenant.env, set mode 0600, and never commit the copy.
# Values below are placeholders only. Generate a long random encryption key.
MCP_CONNECTION_ENCRYPTION_KEY=replace-with-a-long-random-secret
MCP_DATABASE_PATH=/data/tenant.sqlite3
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
GITHUB_CALLBACK_URL=https://mcp.social.dpdns.org/auth/github/callback
MCP_PUBLIC_URL=https://mcp.social.dpdns.org
